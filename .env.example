# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Azure App Registration (personal Microsoft accounts / consumers)
# Portal: https://portal.azure.com → App registrations
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# consumers = solo cuentas personales (live.com / outlook.com)
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/consumers/v2.0

# OneDrive Excel item (resid de la URL de OneDrive)
EXCEL_DRIVE_ITEM_ID=3cec66d5-ed44-4799-8089-a801fc93a9f2
